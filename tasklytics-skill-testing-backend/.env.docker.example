# Example environment file for running the backend via Docker Compose.
# Copy this file to ".env.docker" in this same folder and fill in real values.
# Never commit the real ".env.docker" — it is already covered by this folder's .gitignore.

# --- Database ---
# Host must be "db" — the postgres SERVICE NAME in the root docker-compose.yml —
# not "localhost" or "127.0.0.1". Containers reach each other by service name over
# the Compose network, not by host loopback.
# user / password / dbname here must exactly match the `db` service's
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in docker-compose.yml.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/tasklytics

# --- Auth ---
# Signs/verifies JWT tokens (python-jose, HS256). Use a long random string.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY

# --- Runtime mode ---
# Tells the app it's running inside Docker: app/database.py / config loading skips
# python-dotenv (Docker injects env vars directly into the container).
ENV=docker

# --- AI ---
# Read by app/services/ai/claude_client.py as ANTHROPIC_API_KEY specifically.
# NOTE: this must be named ANTHROPIC_API_KEY, not CLAUDE_API_KEY — the SDK client
# construction (anthropic.Anthropic()) looks up this exact name at import time,
# and app.main fails to import at all if it's missing.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# --- Error tracking (optional) ---
# If unset or empty, sentry_sdk.init(dsn=None) is a documented no-op — the app
# starts and runs normally with no error tracking active. Only set this once a
# real Sentry project exists; see docs/PHASE_5_EXECUTION_TRACKER.md.
SENTRY_DSN=
